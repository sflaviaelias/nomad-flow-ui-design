# Copie para .env.development.local somente quando a configuração for autorizada.
# Esse arquivo vale para npm run dev/build:dev; não configura o build de produção.
# Preencha ambos os valores exclusivamente com os dados do projeto go-nomad-dev.
# URL esperada: https://<PROJECT_REF_DO_GO_NOMAD_DEV>.supabase.co
VITE_SUPABASE_URL=
# Chave publishable ou anon pública do mesmo projeto. Nunca use service_role/secret.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Antes de iniciar o app, valide offline:
# node scripts/check-supabase-development.mjs --project-ref <PROJECT_REF_DO_GO_NOMAD_DEV>
