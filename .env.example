# Copie para .env.local somente quando for configurar o ambiente de desenvolvimento.
# Preencha ambos os valores exclusivamente com os dados do projeto go-nomad-dev.
# URL esperada: https://<PROJECT_REF_DO_GO_NOMAD_DEV>.supabase.co
VITE_SUPABASE_URL=
# Chave publishable ou anon pública do mesmo projeto. Nunca use service_role/secret.
VITE_SUPABASE_PUBLISHABLE_KEY=
